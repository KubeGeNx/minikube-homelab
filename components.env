# Single source of truth for which components are installed.
#
# Set a component to "false" to have it skipped entirely. Then rebuild and
# re-apply the platform ApplicationSet:
#   ./scripts/04-apply-apps.sh
# scripts/build-applicationset.py leaves that component's element out of the
# ApplicationSet's list when it builds gitops/rendered/applicationset.yaml,
# and Argo CD's own applicationset-controller -- not this script -- deletes
# the matching child Application (cascading to its resources via the
# resources-finalizer) because it's no longer in the list. Set back to
# "true" and re-run the same command to bring it back.
#
# See scripts/lib-components.sh for the table mapping each flag to its
# Argo CD Application(s) and gitops/apps/*.yaml file(s).

CERT_MANAGER_ENABLED=true

# LoadBalancer IPs without `minikube tunnel`. NOTE: with the docker driver
# on macOS the pool IPs are only reachable inside Docker's network, so
# tunnel remains the practical path there -- useful mainly for qemu/vfkit
# drivers or Linux. Pool is configured by scripts/07-metallb-config.sh.
METALLB_ENABLED=false
EXTERNAL_SECRETS_ENABLED=false
ENVOY_GATEWAY_ENABLED=true

KUBE_PROMETHEUS_STACK_ENABLED=true
LOKI_STACK_ENABLED=true

# Traces backend (Grafana Tempo) + unified collector (Grafana Alloy:
# logs -> Loki, annotated-pod metrics -> Prometheus, OTLP traces -> Tempo).
TEMPO_ENABLED=true
ALLOY_ENABLED=true
MINIO_ENABLED=true
VELERO_ENABLED=true

# Operator Lifecycle Manager. Not Helm-packaged (like Kubeflow) --
# installed from official release manifests by scripts/06-olm.sh, driven
# by scripts/04-apply-apps.sh. Only useful if you consume OperatorHub.
OLM_ENABLED=true

# AI agent framework (kagent.dev). Needs an LLM provider API key to be
# useful -- run KAGENT_PROVIDER_API_KEY=sk-... ./scripts/09-kagent-secret.sh
# before flipping this to true (or use `make kagent`). Controls both the
# kagent-crds and kagent Applications.
KAGENT_ENABLED=false

# Full Kubeflow suite (Pipelines, Notebooks, Katib, Training Operator,
# KServe, Dashboard). Installed via git+kustomize, not Helm -- see
# gitops/special/16-kubeflow.yaml. VERY heavy: on top of everything else in
# this platform, expect to need well more than the current Minikube sizing
# (raise MINIKUBE_CPUS/MINIKUBE_MEMORY significantly, or disable other
# components to make room, before enabling this). Also one of the more
# finicky installs in the Kubernetes ecosystem generally -- expect to need
# to look at `kubectl get application kubeflow -n argocd` and its sync
# errors if it doesn't converge cleanly on the first try.
KUBEFLOW_ENABLED=false
