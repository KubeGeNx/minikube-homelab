# Single source of truth for which components are installed.
#
# Set a component to "false", regenerate the checked-in plan/output, then
# apply it:
#   ENV=dev bash scripts/build-applicationset.sh
#   ENV=dev bash scripts/04-apply-apps.sh
# scripts/build-applicationset.py leaves that component's element out of the
# ApplicationSet's list when it builds gitops/rendered/applicationset.yaml,
# and Argo CD's own applicationset-controller -- not this script -- deletes
# the matching child Application (cascading to its resources via the
# resources-finalizer) because it's no longer in the list. Set back to
# "true" and re-run the same command to bring it back.
#
# config/platform-catalog.yaml maps each flag to install handlers, manifests,
# dependency metadata, and routes. The generated plan records the resolution.

CERT_MANAGER_ENABLED=true

# Policy engine (kyverno.io): validate/mutate/generate admission policies
# via ClusterPolicy CRDs, enforced by a ValidatingAdmissionWebhook. Chart
# installs its own CRDs (crds.install=true default).
KYVERNO_ENABLED=false

# LoadBalancer IPs without `minikube tunnel`. NOTE: with the docker driver
# on macOS the pool IPs are only reachable inside Docker's network, so
# tunnel remains the practical path there -- useful mainly for qemu/vfkit
# drivers or Linux. Pool is configured by scripts/07-metallb-config.sh.
METALLB_ENABLED=false
EXTERNAL_SECRETS_ENABLED=false
ENVOY_GATEWAY_ENABLED=true

KUBE_PROMETHEUS_STACK_ENABLED=true
LOKI_ENABLED=true

# Traces backend (Grafana Tempo) + unified collector (Grafana Alloy:
# logs -> Loki, annotated-pod metrics -> Prometheus, OTLP traces -> Tempo).
TEMPO_ENABLED=true
ALLOY_ENABLED=true

# Long-term metrics store (Grafana Mimir, distributed, on SeaweedFS). Prometheus
# from kube-prometheus-stack stays -- it keeps the Operator, ServiceMonitors,
# kube-state-metrics, node-exporter and Grafana -- but its local retention
# drops to a few hours and it remote-writes here for anything longer.
# Depends on seaweedfs.
MIMIR_ENABLED=true

# OpenTelemetry Collector, TWO TIERS behind one flag -- this single flag
# controls both Argo CD Applications:
#
#   otel-agent   (26-otel-agent.yaml,   DaemonSet,   wave 5)
#   otel-gateway (27-otel-gateway.yaml, StatefulSet, wave 4)
#
# Applications send OTLP to the AGENT, not the gateway:
#   http://otel-agent-opentelemetry-collector.otel.svc:4317
# The chart puts internalTrafficPolicy: Local on a DaemonSet Service, so that
# name always resolves to the agent on the pod's own node.
#
# The agent enriches (k8sattributes -- only correct on-node, before the source
# IP becomes the agent's), redacts prompt/completion content before it leaves
# the node, derives RED metrics with spanmetrics/servicegraph from 100% of
# spans, then forwards over mTLS keyed on trace ID. The gateway tail-samples
# (keep every error/slow/expensive/deep-loop trace, sample the rest) and is the
# only egress to Tempo.
#
# Span metrics live in the agent ON PURPOSE: behind the sampler they would
# count the surviving ~10% and silently understate every rate in Grafana.
#
# Complements rather than replaces Alloy, which still owns logs -> Loki and
# pod metrics -> Prometheus until the Loki 3 migration.
# Depends on tempo (`make otel-collector` pulls it in, and enables both tiers).
OTEL_COLLECTOR_ENABLED=true
SEAWEEDFS_ENABLED=true

# OpenTelemetry eBPF Instrumentation (OBI, ex-Grafana Beyla): zero-code
# HTTP/gRPC spans and RED metrics for any pod, no SDK and no redeploy.
# Exports to the node-local otel-agent so it inherits enrichment, redaction
# and pre-sampling spanmetrics. Depends on otel-collector.
#
# DEFAULT OFF, and it should stay that way until someone reviews the
# trade-off. Even in its unprivileged mode (which this platform uses -- caps
# dropped to BPF/PERFMON/SYS_PTRACE/NET_RAW/NET_ADMIN/CHECKPOINT_RESTORE/
# DAC_READ_SEARCH, read-only rootfs) it still requires hostPID and
# hostNetwork, because attaching uprobes to other processes means being able
# to see them. Its namespace is therefore PSA-privileged.
#
# It does NOT replace SDK instrumentation for AI workloads: no gen_ai.*
# attributes, no token counts. See gitops/apps/29-obi.yaml.
#
# Feasibility verified on this cluster: kernel 6.12.76-linuxkit with
# CONFIG_DEBUG_INFO_BTF=y. Without BTF, OBI will not start.
OBI_ENABLED=false
VELERO_ENABLED=false

# Operator Lifecycle Manager. Not Helm-packaged (like Kubeflow) --
# installed from official release manifests by scripts/06-olm.sh, driven
# by scripts/04-apply-apps.sh. Only useful if you consume OperatorHub.
OLM_ENABLED=true

# AI agent framework (kagent.dev). Needs an LLM provider API key to be
# useful -- run KAGENT_PROVIDER_API_KEY=sk-... ./scripts/09-kagent-secret.sh
# before flipping this to true (or use `make kagent`). Controls both the
# kagent-crds and kagent Applications.
KAGENT_ENABLED=false

# Agent gateway (agentgateway.dev): Gateway API-native proxy for agentic
# traffic (LLM providers, MCP servers, A2A) plus plain HTTP. Controls both
# the agentgateway-crds and agentgateway Applications. Requires the Gateway
# API CRDs (installed by scripts/02-foundational-crds.sh) and the OCI repo
# registration in scripts/03-argocd.sh. Try it with
# examples/agentgateway-httpbin-sample.yaml after enabling (`make agentgateway`).
AGENTGATEWAY_ENABLED=false

# Event-driven autoscaler (keda.sh): scales workloads on custom event
# sources (queues, Kafka, Prometheus metrics, etc.) via ScaledObject/
# ScaledJob CRDs, on top of what the HPA can do off CPU/memory alone.
KEDA_ENABLED=true

# Vertical Pod Autoscaler (fairwinds-stable/vpa chart, wraps
# kubernetes/autoscaler's VPA): recommender + updater + admission
# controller, right-sizes CPU/memory requests via VerticalPodAutoscaler
# CRDs. Safe to run alongside KEDA -- KEDA scales replica count, VPA scales
# per-pod requests; don't point both at the same resource dimension for one
# workload (e.g. VPA on CPU + HPA/KEDA on CPU) or they'll fight.
VPA_ENABLED=true

# Self-hosted GitLab CE (git hosting, CI config, container registry) + a
# GitLab Runner registered against it -- Argo CD (already installed, always
# on) then watches whatever gitops repo you push there, giving you the full
# push -> build/test -> deploy loop locally: GitLab CE hosts the repo,
# GitLab Runner runs the .gitlab-ci.yml pipeline, Argo CD syncs the result.
# HEAVY (comparable to Kubeflow) -- the official chart brings its own
# Postgres/Redis/Gitaly/registry/Envoy Gateway; expect to need well more
# than the current Minikube sizing, and a first-sync babysit (`kubectl get
# pods -n gitlab`) since it's a lot of subcharts to converge. TLS is left
# off by default (see gitops/apps/22-gitlab.yaml) to sidestep wiring it to
# our cert-manager issuer -- add it yourself once it's up if you want it.
# GITLAB_RUNNER_ENABLED needs a runner auth token from the running GitLab
# instance first -- see scripts/11-gitlab-runner-secret.sh.
GITLAB_ENABLED=false
GITLAB_RUNNER_ENABLED=false

# Message broker (rabbitmq.com), via the bitnami/rabbitmq chart. Backs the
# .NET producer/consumer sample in examples/dotnet-rabbitmq/ -- an
# end-to-end demo of OpenTelemetry traces flowing through a queue (producer
# and consumer spans stitched into one trace via W3C traceparent headers)
# and of KEDA's rabbitmq scaler scaling the consumer on queue depth. Enables
# the Prometheus metrics plugin + a ServiceMonitor, so it needs
# kube-prometheus-stack for the ServiceMonitor CRD (`make rabbitmq` pulls it
# in automatically).
RABBITMQ_ENABLED=true

# Workflow orchestration (airflow.apache.org). LocalExecutor, no Celery/Redis.
AIRFLOW_ENABLED=false

# Full Kubeflow suite (Pipelines, Notebooks, Katib, Training Operator,
# KServe, Dashboard). Installed via git+kustomize, not Helm -- see
# gitops/special/16-kubeflow.yaml. VERY heavy: on top of everything else in
# this platform, expect to need well more than the current Minikube sizing
# (raise MINIKUBE_CPUS/MINIKUBE_MEMORY significantly, or disable other
# components to make room, before enabling this). Also one of the more
# finicky installs in the Kubernetes ecosystem generally -- expect to need
# to look at `kubectl get application kubeflow -n argocd` and its sync
# errors if it doesn't converge cleanly on the first try.
KUBEFLOW_ENABLED=false
