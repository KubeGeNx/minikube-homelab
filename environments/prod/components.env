# prod component overlay -- full HA.
#
# Only flags that DIFFER from the base ../../components.env belong here.

GITLAB_ENABLED=false
GITLAB_RUNNER_ENABLED=false
KUBEFLOW_ENABLED=false
AIRFLOW_ENABLED=false
METALLB_ENABLED=false

# Enforced, not advisory.
KYVERNO_ENABLED=true
EXTERNAL_SECRETS_ENABLED=true

# Backups are not optional in production.
VELERO_ENABLED=true

# eBPF instrumentation is a privileged DaemonSet -- opt in per environment
# after the security review, never by inheriting a base default.
OBI_ENABLED=false
