# staging component overlay -- production topology at reduced scale.
#
# Only flags that DIFFER from the base ../../components.env belong here.

# Heavy, developer-facing components have no place in a staging cluster whose
# job is to rehearse production upgrades.
GITLAB_ENABLED=false
GITLAB_RUNNER_ENABLED=false
KUBEFLOW_ENABLED=false
AIRFLOW_ENABLED=false

# MetalLB: staging runs on real nodes, so LoadBalancer IPs come from the
# cloud provider, not MetalLB.
METALLB_ENABLED=false

# Policy engine ON everywhere above dev -- the AI-workload policies (W8) are
# validated here in Audit mode before prod enforces them.
KYVERNO_ENABLED=true

# Secrets come from a real vault above dev, never hand-created Secrets.
EXTERNAL_SECRETS_ENABLED=true
