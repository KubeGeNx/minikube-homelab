# Generated by scripts/render-apps.sh / build-applicationset.sh -- never
# edit by hand. Source of truth is gitops/apps/*.yaml + versions.env +
# components.env + environments/<env>/.
#
# Note the trailing /* rather than /: git never descends into an excluded
# DIRECTORY, so a "!gitops/rendered/prod/" negation under "gitops/rendered/"
# would silently do nothing. Excluding the contents instead keeps the
# directory traversable so the negations below actually apply.
gitops/rendered/*

# Rendered plans, collector configs, and ApplicationSets are reviewable inputs
# to apply in every environment, so check them in and verify freshness first.
!gitops/rendered/dev/
!gitops/rendered/staging/
!gitops/rendered/prod/

# Plaintext credentials -- never commit.
credentials-velero
*credentials*

# Python bytecode
__pycache__/
*.pyc

# Editor/OS noise
.DS_Store

# Codegraph data
.codegraph
