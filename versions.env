# Single source of truth for every component version in this platform.
#
# Edit by hand, or run ./update-versions.sh to refresh everything to the
# latest available version automatically (see README.md).
#
# scripts/build-applicationset.py substitutes these into gitops/apps/*.yaml
# while building gitops/rendered/applicationset.yaml, so changing a value
# here and re-running ./scripts/04-apply-apps.sh (or ./bootstrap.sh) is the
# only thing you need to do to move a component to a new version.
# (KUBEFLOW_VERSION is the exception -- it's a git tag for the
# kubeflow/manifests repo, consumed directly by
# gitops/special/16-kubeflow.yaml, not by the ApplicationSet.)

# --- Networking ---
CERT_MANAGER_VERSION=v1.21.1
ENVOY_GATEWAY_VERSION=v1.9.0
GATEWAY_API_VERSION=v1.6.1
METALLB_VERSION=0.16.1

# --- GitOps engine ---
ARGOCD_CHART_VERSION=10.4.0

# --- Source control & CI ---
GITLAB_VERSION=10.2.4
GITLAB_RUNNER_VERSION=0.91.2

# --- Policy & Security ---
EXTERNAL_SECRETS_VERSION=2.9.0
KYVERNO_VERSION=3.8.2

# --- Messaging ---
RABBITMQ_CHART_VERSION=16.0.14

# --- Storage ---
MINIO_CHART_VERSION=5.4.0
SNAPSHOTTER_VERSION=v8.6.0

# --- Observability ---
KUBE_PROMETHEUS_STACK_VERSION=88.5.0
# Loki 3.x via the maintained grafana/loki chart. The old loki-stack chart is
# deprecated upstream and was pinned to Loki 2.x, which has no OTLP endpoint.
LOKI_CHART_VERSION=7.3.0
# tempo-distributed, not the monolithic `tempo` chart -- different chart,
# different version series.
TEMPO_CHART_VERSION=1.61.3
# Long-term metrics store. NOTE: mimir-distributed publishes -weekly
# prereleases; update-versions.sh already filters anything containing "-",
# which is what keeps those out.
MIMIR_CHART_VERSION=6.2.0
OTEL_COLLECTOR_CHART_VERSION=0.172.0
# OpenTelemetry eBPF Instrumentation (ex-Grafana Beyla). NOT the
# `opentelemetry-ebpf` chart, which is the older network-flow project.
OBI_CHART_VERSION=0.13.0
ALLOY_CHART_VERSION=1.11.1

# --- Backup & DR ---
VELERO_VERSION=12.1.0

# --- Autoscaling ---
KEDA_VERSION=2.20.2
VPA_CHART_VERSION=5.0.0

# --- Operators ---
# Git release tag of operator-framework/operator-lifecycle-manager.
OLM_VERSION=v0.46.0

# --- AI / ML ---
AGENTGATEWAY_VERSION=v1.3.1
KAGENT_VERSION=v0.1.5
KUBEFLOW_VERSION=v1.10.0

# --- Workflow orchestration ---
AIRFLOW_VERSION=1.22.0
